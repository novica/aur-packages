# Maintainer: novica <nnovica@gmail.com>

pkgname=tinyetl
pkgver=0.12.1 # renovate: datasource=github-releases depName=alrpal/TinyETL
pkgrel=1
pkgdesc="Fast, zero-config ETL in a single binary"
url="https://github.com/alrpal/TinyETL"
arch=('x86_64' 'aarch64')
license=('Apache-2.0')
depends=(
    gcc-libs
    glibc
    openssl
    unixodbc)
conflicts=('tinyetl-bin')
optdepends=()
makedepends=('rust')
options=('!lto' '!debug')
source=("tinyetl-${pkgver}.tar.gz::https://github.com/alrpal/TinyETL/archive/v${pkgver}.tar.gz")

prepare() {
    cd "${srcdir}/TinyETL-${pkgver}"
    cargo fetch
}

build() {
  cd "${srcdir}/TinyETL-${pkgver}"

  cargo build --release --locked
}

package() {
  install -Dm755 "${srcdir}/TinyETL-${pkgver}/target/release/tinyetl"  "${pkgdir}/usr/bin/tinyetl"
  install -Dm644 "${srcdir}/TinyETL-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

sha512sums=('c2cd47f1a3aa400d42cb269e851144e2df6c39d61577cdaab88d7727fc351036e1843d04f07e6452d260fb0063fc3f7ccfd34e23c0a912205923621c13b5bfb5')
